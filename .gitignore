node_modules/
dist/
*.log
.DS_Store
.env
.env.*
!.env.example
_reference/
.cts-cache/

# Wrangler local dev state. Never track this: cf.json caches the geolocation of
# whatever connection last ran wrangler (city, postcode, lat/long, ISP), and
# wrangler-account.json holds the Cloudflare account id and account name.
.wrangler/

# Private working notes — never commit these (market position, other repos, account details).
NOTES.private.md

# `npm pack` output — the release workflow builds one as a Release asset.
*.tgz

# `npm run bundle` output — built in CI, attached to the release.
standalone/

# `npx skills` manager state. The skill itself is tracked in .claude/skills/.
.agents/
skills-lock.json

# Fetched from the GitHub Release at deploy time by deploy-site.yml — never committed.
site/public/cleartoship.mjs
site/public/cleartoship-standalone.tgz
site/public/SHA256SUMS
